{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "cppbuild",
            "label": "C/C++: g++.exe build active file (msys)",
            "command": "c:\\msys64\\ucrt64\\bin\\g++.exe",
            "args": [
                "-fdiagnostics-color=always",
                "-g",
                "-I${workspaceFolder}/include",
                "${workspaceFolder}/src/glad.c",
                "${file}",
                "-L",
                "/ucrt64/lib",
                "-lglfw3",
                "-lopengl32",
                "-lgdi32",
                "-o",
                "${fileDirname}\\${fileBasenameNoExtension}.exe"
            ],
            "options": {
                "cwd": "c:\\msys64\\ucrt64\\bin"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": "build",
            "detail": "Build using msys g++.exe; includes ${workspaceFolder}/include and compiles glad.c"
        },
        {
            "type": "cppbuild",
            "label": "MAC C/C++: g++ build active file MAC",
            "command": "/usr/bin/g++",
            "args": [
                "-fdiagnostics-color=always",
                "-g",
                "-I${workspaceFolder}/include",
                "${workspaceFolder}/src/glad.c",
                "${workspaceFolder}/src/main.cpp",  
                "${workspaceFolder}/src/shaders/Shader.cpp",
                "${workspaceFolder}/src/shaders/VertexShader.cpp",
                "${workspaceFolder}/src/shaders/FragmentShader.cpp",
                "-L${workspaceFolder}/lib-arm64",
                "-lglfw3",
                "-framework",
                "Cocoa",
                "-framework",
                "OpenGL",
                "-framework",
                "IOKit",
                "-framework",
                "CoreVideo",
                "-framework",
                "Metal",
                "-framework",
                "QuartzCore",
                "-o",
                "${fileDirname}/${fileBasenameNoExtension}"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": "build",
            "detail": "BUILT FOR MAC compiler: /usr/bin/g++"
        },
        {
            "type": "cppbuild",
            "label": "Victor C/C++: g++.exe build active file",
            "command": "C:\\msys64\\mingw64\\bin\\g++.exe",
            "args": [
                "-fdiagnostics-color=always",
                "-g",
                "-I${workspaceFolder}/include",
                "-I${workspaceFolder}/include/shaders",
                "${workspaceFolder}/src/glad.c",
                "${workspaceFolder}/src/main.cpp",
                "${workspaceFolder}/src/shaders/Shader.cpp",
                "${workspaceFolder}/src/shaders/ShaderProgram.cpp",
                "${workspaceFolder}/src/shaders/VertexShader.cpp",
                "${workspaceFolder}/src/shaders/FragmentShader.cpp",
                "-LC:\\msys64\\mingw64\\lib",
                "-lglfw3",
                "-lopengl32",
                "-lgdi32",
                "-luser32",
                "-lshell32",
                "-lwinmm",
                "-o",
                "${workspaceFolder}\\src\\main.exe"
            ],
            "options": {
                "cwd": "C:\\Program Files\\LLVM\\bin"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Task generated by Debugger."
        }
    ]
}