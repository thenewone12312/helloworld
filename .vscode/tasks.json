{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "cppbuild",
            "label": "C/C++: g++.exe build active file (msys)",
            "command": "c:\\msys64\\ucrt64\\bin\\g++.exe",
            "args": [
                "-fdiagnostics-color=always",
                "-g",
                "-I${workspaceFolder}/include",
                "${workspaceFolder}/src/glad.c",
                "${file}",
                "-L",
                "/ucrt64/lib",
                "-lglfw3",
                "-lopengl32",
                "-lgdi32",
                "-o",
                "${fileDirname}\\${fileBasenameNoExtension}.exe"
            ],
            "options": {
                "cwd": "c:\\msys64\\ucrt64\\bin"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": "build",
            "detail": "Build using msys g++.exe; includes ${workspaceFolder}/include and compiles glad.c"
        },
        {
            "type": "cppbuild",
            "label": "C/C++: g++ build active file (mac)",
            "command": "/usr/bin/g++",
            "args": [
                "-fdiagnostics-color=always",
                "-g",
                "-I${workspaceFolder}/include",
                "${workspaceFolder}/src/glad.c",
                "${file}",
                "-L${workspaceFolder}/lib-arm64",
                "-lglfw3",
                "-framework",
                "Cocoa",
                "-framework",
                "OpenGL",
                "-framework",
                "IOKit",
                "-framework",
                "CoreVideo",
                "-framework",
                "Metal",
                "-framework",
                "QuartzCore",
                "-o",
                "${fileDirname}/${fileBasenameNoExtension}"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "detail": "Build for macOS (kept for cross-platform reference)"
        },
        {
            "type": "cppbuild",
            "label": "MAC C/C++: g++ build active file MAC",
            "command": "/usr/bin/g++",
            "args": [
                "-fdiagnostics-color=always",
                "-g",
                "-I${workspaceFolder}/include",
                "${workspaceFolder}/src/glad.c",
                "${file}",
                "-L${workspaceFolder}/lib-arm64",
                "-lglfw3",
                "-framework",
                "Cocoa",
                "-framework",
                "OpenGL",
                "-framework",
                "IOKit",
                "-framework",
                "CoreVideo",
                "-framework",
                "Metal",
                "-framework",
                "QuartzCore",
                "-o",
                "${fileDirname}/${fileBasenameNoExtension}"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "compiler: /usr/bin/g++"
        }
    ]
}